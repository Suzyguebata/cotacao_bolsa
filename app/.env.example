# Brapi
# Leave empty to use the free public access. Set a token for paid/final evidence runs.
BRAPI_TOKEN=

# Agendador
MARKET_DATA_POLL_INTERVAL_MINUTES=5
MARKET_DATA_TICKERS=PETR4,VALE3,ITUB4,BBAS3,MGLU3,BBDC4,ABEV3,WEGE3,RENT3,SUZB3,B3SA3,VIVT3,EQTL3,LREN3,AXIA3
MARKET_DATA_API_TIMEOUT_SECONDS=60
MARKET_DATA_MAX_WORKERS=4
LOG_LEVEL=INFO

# Kafka
KAFKA_TOPIC=cotacoes
KAFKA_PRODUCER_RETRIES=5
KAFKA_PRODUCER_RETRY_BACKOFF_MS=500
KAFKA_PRODUCER_LINGER_MS=50
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=15000
KAFKA_PRODUCER_MAX_BLOCK_MS=10000

# Local data lake / MinIO
# These defaults must stay aligned with trino/catalog/delta.properties.
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
DATA_LAKE_BUCKET=datalake

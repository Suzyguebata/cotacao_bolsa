{
    "name": "Data Pipeline B3 - Dev Container",
    "build": {
        "dockerfile": "../app/Dockerfile.spark",
        "context": "../app"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-azuretools.vscode-docker",
